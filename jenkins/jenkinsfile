pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            steps {
                dir('bug-tracker') {
                    // Keeping your existing step for now
                    bat '"C:\\Program Files (x86)\\..." ' 
                }
            }
        }

        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
                sh 'docker compose up --build -d'
            }
        }
    }

    // This goes at the very end, right before the final closing bracket
    post {
        always {
            cleanWs()
        }
    }
}